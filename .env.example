# Which Solana cluster this build talks to: "devnet" (default) or
# "mainnet-beta". Unset means devnet — transactions there cost nothing, so a
# missing variable can never accidentally point a build at real funds. Vercel
# previews stay on devnet; production sets mainnet-beta explicitly.
NEXT_PUBLIC_SOLANA_CLUSTER=

# The Solana RPC the browser calls for blockhashes and confirmations (and,
# later, holdings). Optional — lib/cluster.ts ships a working default per
# cluster. Being NEXT_PUBLIC_ it is readable by anyone who views source, which
# is inherent to calling an RPC from the browser: rate-limit and
# domain-restrict it at the provider. Holders can override it with their own
# endpoint from the wallet modal.
NEXT_PUBLIC_SOLANA_RPC_URL=
